# PostgreSQL database on your VPS
DATABASE_URL=postgres://user:password@your-vps-host:5432/leadgtm
POSTGRES_SSL=false
POSTGRES_SSL_REJECT_UNAUTHORIZED=true

# Supabase Auth (keep if you use the built-in login flow)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bright Data SERP API (https://brightdata.com)
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_SERP_ZONE=serp_api1
BRIGHT_DATA_COUNTRY=in
BRIGHT_DATA_LOCATION=Mumbai, India

# Resend email sending (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=leadgtm <noreply@yourdomain.com>
RESEND_DAILY_LIMIT=50

# OpenAI
OPENAI_API_KEY=

# Inngest (https://inngest.com)
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# Daily digest email settings
DIGEST_FROM_EMAIL=leadgtm <noreply@yourdomain.com>
DIGEST_RECIPIENTS=you@example.com

# Contact form (Request cloud access) - where to receive submissions
CONTACT_FORM_TO=

# Invite codes (comma-separated) - users need one of these to sign up
INVITE_CODES=AUTOGTM

# App URL (used in digest email links)
NEXT_PUBLIC_APP_URL=http://localhost:3200

# Google OAuth (optional - get from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Redis (optional - for rate limiting)
REDIS_URL=
